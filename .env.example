# agent-home — environment template
#
# Copy to .env and fill in real values. .env is gitignored; this file is not.
#
# Variable names in the "Honcho service" section below are Honcho's own and are
# taken verbatim from its .env.template — do not rename them. Everything in the
# "Agent service" section is ours and is read once at startup into the Pydantic
# settings object.


# ─── OpenRouter ───────────────────────────────────────────────────────────────
# One key serves the agent (chat) and Honcho (extraction + embeddings).
# Set a spend limit on this key: Honcho calls a model on every message.

OPENROUTER_API_KEY=sk-
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Chat model for the agent itself.
AGENT_MODEL=anthropic/claude-sonnet-4.5

# Cheap model for Honcho's background extraction. See the Honcho section for
# where this actually gets set — listed here so all model choices sit together.
EXTRACTION_MODEL=openai/gpt-4o-mini

# Embedding model. DECIDED — see DESIGN.md. pgvector bakes the dimension into
# the schema on first run; changing either line later means a migration and a
# full re-embed.
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536


# ─── Agent service (ours) ─────────────────────────────────────────────────────

AGENT_HOST=0.0.0.0
AGENT_PORT=8080

# Honcho happens to read LOG_LEVEL under this exact name too, so this one
# variable sets verbosity for both services.
LOG_LEVEL=INFO


# ─── Honcho, as seen by our agent service (client side) ───────────────────────
# In Docker Compose this is the service name. Running the agent on the host
# during development, it's http://localhost:8000.

HONCHO_BASE_URL=http://honcho:8000
HONCHO_API_KEY=
HONCHO_WORKSPACE_ID=agent-home


# ─── Honcho service (server side) ─────────────────────────────────────────────
# Honcho's own variable names. Stage 4.

DB_CONNECTION_URI=postgresql+psycopg://honcho:replace-me@postgres:5432/honcho

# Auth off for a single-user local deployment. If you turn it on, generate the
# secret with Honcho's scripts/generate_jwt_secret.py.
AUTH_USE_AUTH=false
AUTH_JWT_SECRET=

# Honcho reads the OpenRouter key through its OpenAI-compatible transport.
# Same value as OPENROUTER_API_KEY above.
LLM_OPENAI_API_KEY=sk-or-v1-replace-me

# Background fact extraction — the deriver. Same value as EXTRACTION_MODEL.
DERIVER_ENABLED=true
DERIVER_MODEL_CONFIG__TRANSPORT=openai
DERIVER_MODEL_CONFIG__MODEL=openai/gpt-4o-mini
DERIVER_MODEL_CONFIG__OVERRIDES__BASE_URL=https://openrouter.ai/api/v1

# Embeddings. Must agree with EMBEDDING_MODEL / EMBEDDING_DIMENSIONS above.
EMBED_MESSAGES=true
EMBEDDING_VECTOR_DIMENSIONS=1536
EMBEDDING_MODEL_CONFIG__TRANSPORT=openai
EMBEDDING_MODEL_CONFIG__MODEL=openai/text-embedding-3-small
EMBEDDING_MODEL_CONFIG__OVERRIDES__BASE_URL=https://openrouter.ai/api/v1

# Conversation summarization.
SUMMARY_ENABLED=true
SUMMARY_MODEL_CONFIG__TRANSPORT=openai
SUMMARY_MODEL_CONFIG__MODEL=openai/gpt-4o-mini
SUMMARY_MODEL_CONFIG__OVERRIDES__BASE_URL=https://openrouter.ai/api/v1

# The dialectic endpoint — the query path our memory tool hits. Honcho defines
# five effort levels (minimal, low, medium, high, max), each independently
# configurable via DIALECTIC_LEVELS__<level>__MODEL_CONFIG__*. Only the one we
# call is set here; add others as needed.
DIALECTIC_LEVELS__MEDIUM__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__MEDIUM__MODEL_CONFIG__MODEL=openai/gpt-4o-mini
DIALECTIC_LEVELS__MEDIUM__MODEL_CONFIG__OVERRIDES__BASE_URL=https://openrouter.ai/api/v1

# Offline memory consolidation. Extra model spend for a single-user home
# project; off until the basics work.
DREAM_ENABLED=false

# Redis, used by Honcho as a cache and for worker coordination.
CACHE_ENABLED=true
CACHE_URL=redis://redis:6379/0


# ─── Postgres ─────────────────────────────────────────────────────────────────
# Honcho's storage. Needs the pgvector extension — use a pgvector image, not
# stock postgres. Must match DB_CONNECTION_URI above.

POSTGRES_USER=honcho
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=honcho


# ─── Open WebUI ───────────────────────────────────────────────────────────────
# Keeps its own state in a Docker volume; does not touch the Postgres above.
# The Pipe function's settings are Valves, edited in the admin UI. Only the
# agent URL crosses over from here, as that Valve's default.

OPEN_WEBUI_PORT=3000
WEBUI_SECRET_KEY=replace-me

# Where the Pipe function reaches the agent service. Under Compose both run as
# containers, so this is the agent's service name. If the agent runs on the host
# during development instead, use http://host.docker.internal:8080
AGENT_SERVICE_URL=http://agent:8080
